tools/__pycache__/

# Firestore backups carry real crew names and UIDs in the activity log —
# they are operational safety copies, not source. Keep them local.
tools/out/backups/
tools/out/backup-*.json

# Never publish: machine-specific, PII-bearing, or commercially sensitive.
tests/node_modules

# Redacted Firestore dumps still carry a crew UID, and git history carries a
# name. This repo is PUBLIC — keep them out entirely.
backups/
reference/

# Scratch copy made by tests/lifecycle-test.mjs (now written to TMPDIR).
lifecycle-app/
research/drive/

# Python
__pycache__/
*.pyc
tools/minutes/fonts/

# Subcontractor meeting minutes carry attendee EMAIL ADDRESSES — including
# personal Yahoo/Gmail accounts, not just company aliases — and this repo is
# PUBLIC. The rendered PDF is named PII for a reason. Same standing rule as
# backups/ and reference/: the toolchain in tools/minutes/ is public, the data
# it reads is not. Keep these beside the repo, not in it.
data/minutes-*.json
out/*.pdf
docs/meeting-*-markup-ledger.txt
platform/room3d.html
platform/dist/

# Project contact list carries personal cell numbers and emails (PII).
# This repo is PUBLIC. Contacts live in Firestore only, never in the repo.
platform/tools/private/

# The progress page embeds photographs of the client's unopened hotel as image
# data. Same standing rule as the photographs themselves: this repo is PUBLIC.
# The generator (platform/tools/progress-page.mjs) is source, its output is not.
progress.html

# Snapshot of the crew collection: carries real names and account ids.
tools/out/backups/crew-floor1-snapshot.json

# Photoreal loop (platform/tools/photoreal): the export is derived from
# king-studio.html and large, .blend files are binary scratch, and any blind
# composite or progress page embeds a photograph of the client's unopened
# hotel. The tools are source; their outputs are not.
platform/tools/photoreal/export/
*.blend
*.blend1
platform/tools/photoreal/renders/
platform/tools/photoreal/blind/
photo-loop.html

# Photoreal render pipeline: the exhibit export and the Blender scene are
# derived from platform/king-studio.html by platform/tools/photoreal/ and are
# large. Rebuild them with export.mjs and build.py; never commit them.
platform/tools/photoreal/export/
*.blend
*.blend1
