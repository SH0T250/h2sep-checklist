tools/__pycache__/

# Firestore backups carry real crew names and UIDs in the activity log —
# they are operational safety copies, not source. Keep them local.
tools/out/backups/
tools/out/backup-*.json

# Never publish: machine-specific, PII-bearing, or commercially sensitive.
tests/node_modules

# Redacted Firestore dumps still carry a crew UID, and git history carries a
# name. This repo is PUBLIC — keep them out entirely.
backups/
reference/

# Scratch copy made by tests/lifecycle-test.mjs (now written to TMPDIR).
lifecycle-app/
research/drive/

# Python
__pycache__/
*.pyc
tools/minutes/fonts/

# Subcontractor meeting minutes carry attendee EMAIL ADDRESSES — including
# personal Yahoo/Gmail accounts, not just company aliases — and this repo is
# PUBLIC. The rendered PDF is named PII for a reason. Same standing rule as
# backups/ and reference/: the toolchain in tools/minutes/ is public, the data
# it reads is not. Keep these beside the repo, not in it.
data/minutes-*.json
out/*.pdf
docs/meeting-*-markup-ledger.txt
